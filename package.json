{
  "name": "markdown-diff-preview",
  "displayName": "Markdown Diff Preview",
  "description": "A beautiful Markdown preview that highlights git diffs inline with green/red highlighting for added/removed lines",
  "version": "1.5.1",
  "publisher": "batlounis",
  "author": {
    "name": "Salim Batlouni"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/batlounis/markdown-diff-preview"
  },
  "bugs": {
    "url": "https://github.com/batlounis/markdown-diff-preview/issues"
  },
  "homepage": "https://github.com/batlounis/markdown-diff-preview#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "git",
    "diff",
    "documentation",
    "git diff",
    "markdown preview",
    "live preview",
    "changes"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownDiffPreview.open",
        "title": "Open Markdown Diff Preview",
        "icon": "$(preview)"
      },
      {
        "command": "markdownDiffPreview.openDiagramsView",
        "title": "Open Markdown Diagrams View",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "markdownDiffPreview.refresh",
        "title": "Refresh Markdown Diff Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownDiffPreview.nextDiff",
        "title": "Markdown Diff Preview: Go to Next Diff",
        "icon": "$(arrow-down)"
      },
      {
        "command": "markdownDiffPreview.previousDiff",
        "title": "Markdown Diff Preview: Go to Previous Diff",
        "icon": "$(arrow-up)"
      },
      {
        "command": "markdownDiffPreview.toggleViewMode",
        "title": "Markdown Diff Preview: Toggle Normal/Diff Mode"
      },
      {
        "command": "markdownDiffPreview.showNormalMode",
        "title": "Markdown Diff Preview: Show Normal Mode"
      },
      {
        "command": "markdownDiffPreview.showDiffMode",
        "title": "Markdown Diff Preview: Show Diff Mode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "markdownDiffPreview.open",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownDiffPreview.open",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdownDiffPreview.openDiagramsView",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdownDiffPreview.nextDiff"
        },
        {
          "command": "markdownDiffPreview.previousDiff"
        },
        {
          "command": "markdownDiffPreview.toggleViewMode"
        },
        {
          "command": "markdownDiffPreview.showNormalMode"
        },
        {
          "command": "markdownDiffPreview.showDiffMode"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownDiffPreview.open",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == markdown"
      },
      {
        "command": "markdownDiffPreview.nextDiff",
        "key": "alt+down",
        "mac": "alt+down",
        "when": "activeCustomEditorId == 'markdownDiffPreview' || activeWebviewPanelId == 'markdownDiffPreview'"
      },
      {
        "command": "markdownDiffPreview.previousDiff",
        "key": "alt+up",
        "mac": "alt+up",
        "when": "activeCustomEditorId == 'markdownDiffPreview' || activeWebviewPanelId == 'markdownDiffPreview'"
      }
    ],
    "configuration": {
      "title": "Markdown Diff Preview",
      "properties": {
        "markdownDiffPreview.diffBase": {
          "type": "string",
          "default": "HEAD",
          "description": "Git ref to compare against (e.g., HEAD, main, origin/main)"
        },
        "markdownDiffPreview.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line numbers in the diff highlighting"
        },
        "markdownDiffPreview.highlightStyle": {
          "type": "string",
          "enum": [
            "inline",
            "gutter",
            "both"
          ],
          "default": "both",
          "description": "How to display diff highlights"
        },
        "markdownDiffPreview.enableWordDiff": {
          "type": "boolean",
          "default": true,
          "description": "Enable word-level diff highlighting for modified lines"
        },
        "markdownDiffPreview.enableMath": {
          "type": "boolean",
          "default": true,
          "description": "Render LaTeX math ($...$, $$...$$, \\(...\\), \\[...\\]) with KaTeX"
        },
        "markdownDiffPreview.classDiagramDetail": {
          "type": "string",
          "enum": [
            "minimal",
            "compact",
            "full"
          ],
          "default": "full",
          "description": "How much detail to show in class diagrams (Diagrams view only): minimal shows class names only, compact also shows properties (members without +/- prefix), full shows everything"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node -r ts-node/register --test test/*.test.ts",
    "demo": "npx ts-node scripts/generate-demo.ts",
    "demo:serve": "npx ts-node scripts/generate-demo.ts && npx serve . -l 3000 --no-clipboard",
    "build:mermaid": "node scripts/build-mermaid-bundle.mjs",
    "publish": "ovsx publish --pat $OVSX_PAT"
  },
  "devDependencies": {
    "@mermaid-js/layout-elk": "0.2.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "0.28.2",
    "eslint": "^8.54.0",
    "mermaid": "11.17.2",
    "ovsx": "^0.10.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "marked": "^11.1.0"
  }
}
